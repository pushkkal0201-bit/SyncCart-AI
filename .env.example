APP_NAME=SyncCart AI
APP_ENV=hackathon
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./runtime/synccart.db
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3})(:\d+)?$
TRUSTED_HOSTS=localhost,127.0.0.1
REQUEST_ID_HEADER=X-Request-ID
CUSTOMER_SESSION_TOKEN_HEADER=X-Session-Token
IDEMPOTENCY_HEADER=Idempotency-Key
CUSTOMER_SESSION_TOKEN_TTL_MINUTES=480
DUPLICATE_SCAN_WINDOW_MS=1500
SCAN_GRACE_PERIOD_MS=4000
EVENT_MATCH_WINDOW_MS=8000
NUDGE_TO_REVIEW_MS=8000
RECONCILIATION_SWEEP_INTERVAL_MS=500
MIN_VISION_CONFIDENCE=0.55
ENABLE_RECONCILIATION_WORKER=true
ENABLE_SIMULATOR=true
SIMULATOR_API_KEY=replace-with-a-random-local-demo-key
SIMULATOR_API_KEY_HEADER=X-Simulator-Key
STORE_OPS_API_KEY=replace-with-a-random-local-store-key
STORE_OPS_API_KEY_HEADER=X-Store-Key
MONITORING_API_KEY=replace-with-a-random-local-monitor-key
MONITORING_API_KEY_HEADER=X-Monitor-Key
VISION_API_KEY=replace-with-a-random-local-vision-key
VISION_API_KEY_HEADER=X-Vision-Key

# Phase 7 live Vision commissioning controls
VISION_CONTROL_KEY=replace-with-a-random-local-vision-control-key
VISION_CONTROL_KEY_HEADER=X-Vision-Control-Key
VISION_EVENTS_ARMED=false
FROZEN_FRAME_LIMIT=90
FROZEN_FRAME_PIXEL_EPSILON=0.001
SQL_ECHO=false

WEBSOCKET_SNAPSHOT_INTERVAL_MS=500
WEBSOCKET_HEARTBEAT_MS=15000

# Edge Vision worker
CORE_API_BASE_URL=http://127.0.0.1:8000
# Production: use a fixed retail CCTV/NVR camera ID and RTSP/HTTP stream.
# Prototype: Phone 1 IP Webcam can be used with the same adapter.
CAMERA_ID=EDGE-CAM-01
CAMERA_SOURCE=0
CAMERA_SOURCE_NAME=Retail Edge Camera
# Examples (do not commit real credentials):
# CAMERA_SOURCE=rtsp://user:password@10.10.20.31:554/stream1
# CAMERA_SOURCE=http://PHONE-IP:8080/video
CAMERA_STREAM_MODE=AUTO
# AUTO is portable. FFMPEG is recommended for many RTSP CCTV streams when available.
CAMERA_BACKEND=AUTO
# Low buffer values reduce stale frames; backend support varies.
CAMERA_BUFFER_SIZE=1
CAMERA_RECONNECT_DELAY_MS=1000
CAMERA_READ_TIMEOUT_MS=5000
PLANOGRAM_PATH=config/vision_planogram.yaml
# AUTO prefers YOLO when optional weights are present, otherwise it uses the built-in
# fixed-zone reference detector for the calibrated shelf demo.
DETECTOR_MODE=AUTO
OCCUPANCY_SIMILARITY_THRESHOLD=0.76
OCCUPANCY_WARMUP_FRAMES=5
OCCUPANCY_SAMPLE_SIZE=96
YOLO_WEIGHTS=models/weights/synccart-sku-v001.pt
YOLO_DEVICE=cpu
YOLO_CONFIDENCE=0.55
YOLO_IOU=0.45
FRAME_STRIDE=1
STABLE_FRAME_COUNT=4
EVENT_COOLDOWN_MS=1200
TELEMETRY_INTERVAL_MS=2000
JPEG_QUALITY=80
DRAW_OVERLAYS=true
VISION_RUN_WORKER=true
MODEL_NAME=synccart-sku
MODEL_VERSION=v001
